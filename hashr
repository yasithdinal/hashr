#!/usr/bin/env python3
import argparse
import sys
import requests

API_URL = "https://hashes.com/en/api/identifier"


def print_banner():
    print(r"""
 _               _
| |__   __ _ ___| |__  _ __
| '_ \ / _` / __| '_ \| '__|
| | | | (_| \__ \ | | | |
|_| |_|\__,_|___/_| |_|_|

          hashr
     Hash Identifier
       Author: Yasith
    """)


def identify_hash(hash_value: str, extended: bool = False) -> list[str]:
    params = {"hash": hash_value}

    if extended:
        params["extended"] = "true"

    try:
        response = requests.get(API_URL, params=params, timeout=15)
        response.raise_for_status()
        data = response.json()
    except requests.RequestException as exc:
        raise RuntimeError(f"API request failed: {exc}") from exc
    except ValueError as exc:
        raise RuntimeError("Hashes.com returned invalid JSON.") from exc

    if not data.get("success"):
        raise RuntimeError(data.get("message", "Could not identify hash."))

    return data.get("algorithms", [])


def read_hashes_from_file(file_path: str) -> list[str]:
    try:
        with open(file_path, "r", encoding="utf-8") as file:
            return [line.strip() for line in file if line.strip()]
    except OSError as exc:
        raise RuntimeError(f"Could not read file: {exc}") from exc


def process_hash(hash_value: str, extended: bool = False):
    try:
        algorithms = identify_hash(hash_value, extended)
    except RuntimeError as exc:
        print(f"[!] {exc}")
        return

    print(f"\n[+] Hash: {hash_value}")

    if not algorithms:
        print("[-] No matching algorithms found.")
        return

    print("[+] Possible algorithms:")

    for algorithm in algorithms:
        print(f"    {algorithm}")


def main():
    print_banner()

    parser = argparse.ArgumentParser(
        description="Identify hash algorithms using the Hashes.com API."
    )

    input_group = parser.add_mutually_exclusive_group(required=True)

    input_group.add_argument(
        "hash",
        nargs="?",
        help="Hash to identify",
    )

    input_group.add_argument(
        "-f",
        "--file",
        help="File containing hashes [one hash per line]",
    )

    parser.add_argument(
        "-e",
        "--extended",
        action="store_true",
        help="Return extended algorithm matches",
    )

    args = parser.parse_args()

    if args.file:
        try:
            hashes = read_hashes_from_file(args.file)
        except RuntimeError as exc:
            print(f"[!] {exc}", file=sys.stderr)
            return 1

        if not hashes:
            print("[!] File does not contain any hashes.", file=sys.stderr)
            return 1

        print(f"[+] Loaded {len(hashes)} hash(es) from {args.file}")

        for hash_value in hashes:
            process_hash(hash_value, args.extended)
    else:
        process_hash(args.hash, args.extended)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
