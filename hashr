#!/usr/bin/env python3
import argparse
import sys
import requests

API_URL = "https://hashes.com/en/api/identifier"


def print_banner():
    print(r"""
 _               _
| |__   __ _ ___| |__  _ __
| '_ \ / _` / __| '_ \| '__|
| | | | (_| \__ \ | | | |
|_| |_|\__,_|___/_| |_|_|

          hashr
     Hash Identifier
       Author: Yasith
    """)


def identify_hash(hash_value: str, extended: bool = False) -> list[str]:
    params = {"hash": hash_value}

    if extended:
        params["extended"] = "true"

    try:
        response = requests.get(API_URL, params=params, timeout=15)
        response.raise_for_status()
        data = response.json()
    except requests.RequestException as exc:
        raise RuntimeError(f"API request failed: {exc}") from exc
    except ValueError as exc:
        raise RuntimeError("Hashes.com returned invalid JSON.") from exc

    if not data.get("success"):
        raise RuntimeError(data.get("message", "Could not identify hash."))

    return data.get("algorithms", [])


def main():
    print_banner()

    parser = argparse.ArgumentParser(
        description="Identify hash algorithms using the Hashes.com API."
    )

    parser.add_argument("hash", help="Hash to identify")

    parser.add_argument(
        "-e",
        "--extended",
        action="store_true",
        help="Return extended algorithm matches",
    )

    args = parser.parse_args()

    try:
        algorithms = identify_hash(args.hash, args.extended)
    except RuntimeError as exc:
        print(f"[!] {exc}", file=sys.stderr)
        return 1

    if not algorithms:
        print("[-] No matching algorithms found.")
        return 0

    print(f"[+] Hash: {args.hash}")
    print("[+] Possible algorithms:")

    for algorithm in algorithms:
        print(f"    {algorithm}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
